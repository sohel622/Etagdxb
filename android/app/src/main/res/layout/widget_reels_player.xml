<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_reels_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Vertical Video Thumbnail Backdrop (9:16 / 4:5 vertical) -->
    <ImageView
        android:id="@+id/widget_reels_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_reel_poster_default"
        android:contentDescription="Reels Video Thumbnail" />

    <!-- Dark Gradient Scrim for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim_overlay" />

    <!-- Top Bar: Logo & Reels Header -->
    <LinearLayout
        android:id="@+id/widget_reels_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_logo_badge_bg"
            android:src="@drawable/ic_stat_flashgram"
            android:tint="#FFFFFF"
            android:padding="3dp"
            android:contentDescription="Flashgram" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Flashgram Reels"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HD"
            android:textColor="#E1306C"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Center Play/Pause Overlay Toggle -->
    <LinearLayout
        android:id="@+id/widget_reels_play_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_reels_play_toggle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/widget_play_btn_bg"
            android:src="@drawable/ic_pip_play_pause"
            android:padding="13dp"
            android:tint="#FFFFFF"
            android:contentDescription="Play/Pause Reel" />

        <TextView
            android:id="@+id/widget_reels_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tap to Watch"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- Bottom Info Overlay (Creator Name & Caption) -->
    <LinearLayout
        android:id="@+id/widget_reels_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_reels_creator_avatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_avatar_placeholder"
                android:contentDescription="Creator Avatar" />

            <TextView
                android:id="@+id/widget_reels_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@flashgram_official"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_reels_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trending Reel ✨ Tap to watch in full-screen"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>
