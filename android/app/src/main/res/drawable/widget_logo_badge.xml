<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient / Pink Round Icon Background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#833AB4"
                android:centerColor="#FD1D1D"
                android:endColor="#FCAF45"
                android:type="linear" />
        </shape>
    </item>
    <!-- Crisp White Flashgram Icon in Center -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <bitmap
            android:src="@drawable/ic_stat_flashgram"
            android:tint="#FFFFFF"
            android:gravity="center" />
    </item>
</layer-list>
