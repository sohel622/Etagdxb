<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2D112C"
                android:centerColor="#1B1226"
                android:endColor="#0D1117"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke android:width="1.2dp" android:color="#2A2A2E" />
        </shape>
    </item>
    <!-- Center Play Circle -->
    <item android:gravity="center" android:width="36dp" android:height="36dp">
        <shape android:shape="oval">
            <solid android:color="#99000000" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
